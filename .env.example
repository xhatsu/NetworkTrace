# ==============================================================================
# TraceScope Example Configuration (.env.example)
# Copy to .env and adjust variables for your target deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
OTEL_HOST=0.0.0.0
OTEL_PORT=30102
OTEL_DATA_DIR=./data
OTEL_DEMO_MODE=true
OTEL_CORS_ORIGINS=http://127.0.0.1:30102,http://localhost:30102,http://localhost:5173
OTEL_API_KEY=

# ------------------------------------------------------------------------------
# 2. STORAGE ARCHITECTURE & BACKENDS
# ------------------------------------------------------------------------------
OTEL_STORAGE_BACKEND=clickhouse
OTEL_TRACE_STORAGE_BACKEND=elasticsearch
OTEL_CLICKHOUSE_ONLY_AGENT_TRACES=true
OTEL_ES_SYNC_ENABLED=true

# ------------------------------------------------------------------------------
# 3. CLICKHOUSE ANALYTICAL DATASTORE
# ------------------------------------------------------------------------------
OTEL_CLICKHOUSE_HOST=10.98.6.4
OTEL_CLICKHOUSE_PORT=8123
OTEL_CLICKHOUSE_DATABASE=tracescope
OTEL_CLICKHOUSE_USER=default
OTEL_CLICKHOUSE_PASSWORD=
OTEL_CLICKHOUSE_ROLE=api
OTEL_CLICKHOUSE_SECURE=false
OTEL_CLICKHOUSE_CONNECT_TIMEOUT=10.0
OTEL_CLICKHOUSE_TIMEOUT=30.0
OTEL_CLICKHOUSE_SYSTEM_LOG_RETENTION_DAYS=1
OTEL_CLICKHOUSE_SYSTEM_ERROR_LOG_RETENTION_DAYS=1
OTEL_TRACE_RETENTION_DAYS=1
OTEL_RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 4. ELASTICSEARCH APM DATASTORE & RETENTION
# ------------------------------------------------------------------------------
OTEL_ES_URL=http://127.0.0.1:32073
OTEL_ES_PORT=32073
OTEL_ES_INDEX=apm-*,traces-apm*
OTEL_ES_TIMEOUT=15.0
OTEL_ES_VERIFY_TLS=false
OTEL_ES_USER=
OTEL_ES_PASSWORD=
OTEL_ES_API_KEY=
OTEL_ES_RETENTION_DAYS=2

# ------------------------------------------------------------------------------
# 5. INGESTION PIPELINE & HIGH-TPS WRITER
# ------------------------------------------------------------------------------
OTEL_INGEST_QUEUE_CAPACITY=256
OTEL_INGEST_COALESCE_MS=5
OTEL_INGEST_TRANSACTION_RECORDS=50000
OTEL_MAX_INGEST_BYTES=10485760
OTEL_MAX_INGEST_RECORDS=10000
OTEL_INGEST_MAX_BATCH_BYTES=33554432
OTEL_INGEST_COMMIT_TIMEOUT_SECONDS=65
OTEL_TRACE_EDGE_SKEW_MS=250

# ------------------------------------------------------------------------------
# 6. NETWORK TOPOLOGY & PROXY ATTRIBUTION
# ------------------------------------------------------------------------------
OTEL_KNOWN_F5=10.240.147.247,10.240.147.249,10.10.1.20,10.20.14.78,10.20.1.15
OTEL_KNOWN_LOAD_BALANCERS=10.240.147.247,10.240.147.249,10.10.1.20,10.20.14.78,10.20.1.15
OTEL_TRUSTED_PROXIES=
OTEL_KNOWN_LB=
OTEL_KNOWN_REVERSE_PROXY=
OTEL_KNOWN_NAT=
OTEL_SERVICE_IP_MAP=

# ------------------------------------------------------------------------------
# 7. BEHAVIORAL ANALYTICS & BASELINE ENGINE
# ------------------------------------------------------------------------------
OTEL_BASELINE_CADENCE_SECONDS=300
OTEL_BASELINE_SERIES_BUDGET=100
OTEL_ANOMALY_WINDOW_BUDGET=100
OTEL_ANALYTICS_STAGE_BUDGET_SECONDS=55
OTEL_BEHAVIOR_LEARNING_ENABLED=true
OTEL_BEHAVIOR_BUDGET_SECONDS=20
OTEL_BEHAVIOR_LEARN_GRACE_SECONDS=90
OTEL_WORKER_START_TIME=
OTEL_WORKER_IGNORE_PAST_DATA=false

# ------------------------------------------------------------------------------
# 8. PRINCIPAL & USER INTELLIGENCE
# ------------------------------------------------------------------------------
OTEL_PRINCIPAL_BOOTSTRAP_RATIO=0.75
OTEL_PRINCIPAL_LEARNING_DAYS=7
OTEL_PRINCIPAL_DORMANT_DAYS=30
OTEL_PRINCIPAL_ACTIVE_MINUTES=15

# ------------------------------------------------------------------------------
# 9. AI SEMANTIC ASSESSMENT & ANOMALY REASONING (L4)
# ------------------------------------------------------------------------------
OTEL_SEMANTIC_ASSESSMENT_ENABLED=false
OTEL_SEMANTIC_PROVIDER=openrouter
OTEL_SEMANTIC_BASE_URL=https://openrouter.ai
OTEL_SEMANTIC_API_KEY=your_openrouter_api_key_here
OTEL_SEMANTIC_MODEL=typesafe/jev-1.13
OTEL_SEMANTIC_TIMEOUT_SECONDS=30
OTEL_SEMANTIC_BATCH_SIZE=2
OTEL_SEMANTIC_BUDGET_SECONDS=20
OTEL_SEMANTIC_RETRY_SECONDS=900

# ------------------------------------------------------------------------------
# 10. ALERTING & NOTIFICATIONS
# ------------------------------------------------------------------------------
OTEL_ALERT_TELEGRAM_TOKEN=your_telegram_bot_token_here
OTEL_ALERT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 11. LLM DEEP INVESTIGATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
OTEL_LLM_INVESTIGATION_ENABLED=false
OTEL_LLM_SINGLE_OWNER_ACK=false
OTEL_LLM_BASE_URL=
OTEL_LLM_API_KEY=
OTEL_LLM_MODEL=
OTEL_LLM_RESPONSE_MODE=json_object
OTEL_LLM_ALLOW_LOOPBACK_HTTP=false
OTEL_LLM_CONTEXT_TOKENS=32768
